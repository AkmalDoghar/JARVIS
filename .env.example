# ===================================================
# JARVIS AI ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and insert your personal API keys.
# Never commit the actual .env file with sensitive keys.
# ===================================================

# Primary AI Cloud Providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-exp:free,qwen/qwen-2.5-coder-32b-instruct:free,deepseek/deepseek-chat:free

# Optional Fallback Providers
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Voice & Speech Configuration
STT_PROVIDER=browser
TTS_PROVIDER=edge-tts
EDGE_TTS_VOICE_URDU=ur-PK-AsadNeural
EDGE_TTS_VOICE_ENGLISH=en-US-ChristopherNeural

# Security & Master PIN (PBKDF2 Salted Hash)
JARVIS_PIN_HASH=
JARVIS_PIN_SALT=

# System Operation Mode (online | offline | hybrid)
JARVIS_MODE=hybrid
LOCAL_MODEL_NAME=llama3.2
LOCAL_MODEL_URL=http://127.0.0.1:11434

